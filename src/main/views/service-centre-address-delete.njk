{% extends "template.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "macros/common-components.njk" import addressBlock, addressType %}

{% block pageTitle %}
  {{ pageTitle }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Are you sure you want to delete this address?</h1>

      <form method="POST" action="/service-centres/{{ address.serviceCentreId }}/edit/address/delete/success/{{ address.id }}">
        {{ govukSummaryList({
          rows: [
            {
              key: { text: "Service centre name" },
              value: { text: serviceCentreName }
            },
            {
              key: { text: "Address type" },
              value: { text: addressType(address) }
            },
            {
              key: { text: "Address" },
              value: { text: addressBlock(address) }
            }
          ]
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Delete address",
            classes: "govuk-button--warning"
          }) }}
          <a class="govuk-link govuk-link--no-visited-state" href="/service-centres/{{ address.serviceCentreId }}/edit/address">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
