{% extends "template.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "macros/common-components.njk" import confirmationActions %}
{% from "macros/csrf.njk" import csrfProtection %}

{% block pageTitle %}
  {{ pageTitle }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Are you sure you want to delete these opening hours?</h1>

      {{ govukSummaryList({
        rows: [
          {
            key: {
              text: "Court name"
            },
            value: {
              text: courtName
            }
          },
          {
            key: {
              text: "Assistance available"
            },
            value: {
              text: assistanceAvailable
            }
          },
          {
            key: {
              text: "Hours"
            },
            value: {
              html: hours
            }
          }
        ]
      }) }}

      <form method="post" action="/courts/{{ courtId }}/edit/counter-service-opening-hours/delete/success/{{ counterServiceId }}">
        {{ csrfProtection(csrfToken) }}
        {{ confirmationActions("Delete opening hours", cancelHref) }}
      </form>
    </div>
  </div>
{% endblock %}
