{% extends "template.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "macros/common-components.njk" import confirmationActions %}

{% block pageTitle %}
  Court photo confirm delete - {{ courtName }}
{% endblock %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-xl">Are you sure you want to remove this Court photo?</h1>

      <form method="post" action="/courts/{{ courtId }}/edit/photo/delete/success">

        {{ govukSummaryList({
          rows: [
            {
              key: { text: "Court name" },
              value: { text: courtName }
            },
            {
              key: { text: "Confirm" },
              value: { text: message }
            }
          ]
        }) }}

        {{ confirmationActions("Continue", cancelHref) }}

      </form>

    </div>
  </div>


{% endblock %}
