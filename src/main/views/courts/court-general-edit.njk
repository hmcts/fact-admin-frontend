{% extends "template.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "macros/common-components.njk" import modelDrivenErrorSummary %}
{% from "macros/csrf.njk" import csrfProtection %}

{% set regionOptions = [] %}
{% if model.regions.length %}
  {% for row in model.regions %}
    {% set regionOptions = (regionOptions.push(
      { value: row.id, text: row.name, selected: row.id == model.regionId }
    ), regionOptions) %}
  {% endfor %}
{% endif %}

{% block pageTitle %}
  {{ pageTitle }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">

    <div class="govuk-grid-column-full">
      {% if model.errors %}
        {{ modelDrivenErrorSummary(model.errors, { ignoreFields: ['timestamp'] }) }}
      {% endif %}

      <h1 class="govuk-heading-l">General</h1>

      <form method="post" action="/courts/{{ model.id }}/edit/general/success">
        {{ csrfProtection(csrfToken) }}
        <fieldset class="govuk-fieldset"{% if isViewer %} disabled{% endif %}>
          <legend class="govuk-fieldset__legend govuk-visually-hidden">General details</legend>

          {{ govukInput({
            label: {
              text: "Name",
              classes: "govuk-fieldset__legend--m"
            },
            hint: {
              text: "Enter the name of the court. Only capitalise the first letter."
            },
            id: "name",
            name: "name",
            spellcheck: true,
            value: model.name,
            errorMessage: {
              text: model.errors.name[0]
            } if model.errors and model.errors.name else null
          }) }}

        {{ govukRadios({
          classes: "govuk-radios--inline",
          id: "open",
          name: "open",
          fieldset: {
            legend: {
              text: "Court status",
              classes: "govuk-fieldset__legend--m"
            }
          },
          hint: {
            text: "Choose whether the court is open or closed. Closed courts are not shown on the public website."
          },
          items: [
            {
              value: "true",
              text: "Open",
              checked: true if model.open else false
            },
            {
              value: "false",
              text: "Closed",
              checked: false if model.open else true
            }
          ],
          errorMessage: {
            text: model.errors.open[0]
          } if model.errors and model.errors.open else null
        }) }}

        {{ govukSelect({
          id: "regionId",
          name: "regionId",
          label: {
            text: "Region",
            classes: "govuk-label--m"
          },
          hint: {
            text: "Select the region in which the court is located."
          },
          items: regionOptions,
          errorMessage: {
            text: model.errors.regionId[0]
          } if model.errors and model.errors.regionId else null
        }) }}

        {% if not isViewer %}
          {{ govukButton({
            text: "Save"
          }) }}
        {% endif %}

        </fieldset>
      </form>
    </div>
  </div>
{% endblock %}
