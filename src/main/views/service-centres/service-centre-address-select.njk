{% extends "template.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "macros/csrf.njk" import csrfProtection %}

{% block pageTitle %}
  {{ pageTitle }}
{% endblock %}

{%- set actionUrl %}
  {% if addressId %}
    /service-centres/{{ serviceCentreId }}/edit/address/details/{{ addressId }}
  {% else %}
    /service-centres/{{ serviceCentreId }}/edit/address/details
  {% endif %}
{% endset -%}

{% set addressOptions = [] %}
{% if addresses.length %}
  {% for row in addresses %}
    {% set addressOptions = (addressOptions.push(
      { value: row | dump, text: row.address }
    ), addressOptions) %}
  {% endfor %}
{% endif %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Select an address</h1>

      <p class="govuk-body">Postcode: {{ postcode }}.</p>

      {% if addresses.length %}
        <form method="POST" action="{{ actionUrl }}">
        {{ csrfProtection(csrfToken) }}

          {% if isNewSC %}
            <input type="hidden" name="isNewSC" value="true">
          {% endif %}

          {{ govukSelect({
            id: "address",
            name: "address",
            label: {
              text: "Choose an address"
            },
            items: addressOptions
          }) }}

          {{ govukButton({
            text: "Continue"
          }) }}
        </form>
      {% else %}
        {% if postcodeMetadata.terminated %}
          <p class="govuk-body">The postcode you have entered is a terminated postcode.</p>
        {% endif %}
        {% if postcodeMetadata.largeUser %}
          <p class="govuk-body">The postcode you have entered is a large user postcode. A large user postcode covers a large rural area or is used by a location that receives large volumes of mail.</p>
        {% endif %}
        {% if postcodeMetadata.terminated or postcodeMetadata.largeUser %}
          <p class="govuk-body">You can still enter an address using this postcode, but you will need to enter the address manually.</p>
        {% else %}
          <p class="govuk-body">No addresses were found for this postcode. Enter the address manually.</p>
        {% endif %}
      {% endif %}

      <form method="POST" action="{{ actionUrl }}">
        {{ csrfProtection(csrfToken) }}
        <input type="hidden" name="postcode" value="{{ postcode }}">

        {% if isNewSC %}
          <input type="hidden" name="isNewSC" value="true">
        {% endif %}

        {{ govukButton({
          text: "Enter address manually",
          classes: "govuk-button--secondary"
        }) }}
      </form>
    </div>
  </div>
{% endblock %}
