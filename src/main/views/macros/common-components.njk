{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% macro confirmationActions(buttonText, cancelHref) %}
  <div class="govuk-button-group">
    {{ govukButton({
      text: buttonText,
      classes: "govuk-button--warning"
    }) }}
    <a class="govuk-link govuk-link--no-visited-state" href="{{ cancelHref }}">Cancel</a>
  </div>
{% endmacro %}

{# Address Block #}
{% macro addressBlock(address, asRow=false) %}
  {%- if asRow %}
    {{ address.addressLine1 }}, {%- if address.addressLine2 %} {{ address.addressLine2 }}, {% endif -%} {{ address.townCity }}, {%- if address.county %} {{ address.county }}, {% endif -%} {{ address.postcode }}
  {% else %}
    <p class="govuk-body govuk-!-margin-bottom-1">{{ address.addressLine1 }}</p>
    {% if address.addressLine2 %}
      <p class="govuk-body govuk-!-margin-bottom-1">{{ address.addressLine2 }}</p>
    {% endif %}
    <p class="govuk-body govuk-!-margin-bottom-1">{{ address.townCity }}</p>
    {% if address.county %}
      <p class="govuk-body govuk-!-margin-bottom-1">{{ address.county }}</p>
    {% endif %}
    <p class="govuk-body govuk-!-margin-bottom-0">{{ address.postcode }}</p>
  {% endif -%}
{% endmacro %}

{# presentable format of the addressType #}
{% macro addressType(address) %}
  {%- if address.addressType === "WRITE_TO_US" %}
    Send documents to
  {% elseif address.addressType === "VISIT_OR_CONTACT_US" %}
    Visit and send documents to
  {% else %} {# visit us #}
    Visit
  {% endif -%}
{% endmacro %}

{# common error summary/linking for templates where we #}
{# explicitly map field ids to schema keys #}
{% macro modelDrivenErrorSummary(modelErrors, options={}) %}
  {% set options = options or {} %}
  {% set ignoreFields = options.ignoreFields or [] %}
  {% set unlinkedFields = options.unlinkedFields or ["message"] %}
  {% set errorList = [] %}
  {% for field, errors in modelErrors or {} %}
    {% if field not in ignoreFields %}
      {% for error in errors %}
        {% set href = "#" + field if field not in unlinkedFields else null %}
        {% set errorList = (errorList.push({
          text: error,
          href: href
        }), errorList) %}
      {% endfor %}
    {% endif %}
  {% endfor %}
  {{ govukErrorSummary({
    titleText: "There is a problem",
    errorList: errorList
  }) }}
{% endmacro %}

{# Common contact details block for list and summary-list rows #}
{% macro contactDetailsBlock(contact, options={}) %}
  {% set options = options or {} %}
  {% if options.inline %}
    {% set parts = [] %}
    {% if options.includeExplanation and contact.explanation %}
      {% set parts = (parts.push(contact.explanation), parts) %}
    {% endif %}
    {% if contact.phoneNumber %}
      {% set parts = (parts.push('Phone: ' + contact.phoneNumber), parts) %}
    {% endif %}
    {% if contact.email %}
      {% set parts = (parts.push('Email: ' + contact.email), parts) %}
    {% endif %}
    {{ parts.join('<br>') | safe }}
  {% else %}
    {% if contact.phoneNumber %}
      <p class="govuk-body govuk-!-margin-bottom-1"><strong>Telephone </strong> {{ contact.phoneNumber }}</p>
    {% endif %}
    {% if contact.email %}
      <p class="govuk-body govuk-!-margin-bottom-0"><strong>Email </strong> {{ contact.email }}</p>
    {% endif %}
  {% endif %}
{% endmacro %}

{# Generic row actions list for table/list action links #}
{% macro rowActions(items) %}
  <ul class="govuk-summary-list__actions-list govuk-!-margin-bottom-0">
    {% for item in items %}
      {%- if item and item.href %}
        <li class="govuk-summary-list__actions-list-item">
          <a class="govuk-link govuk-link--no-visited-state" href="{{ item.href }}">{{ item.text }}</a>
        </li>
      {% endif -%}
    {% endfor %}
  </ul>
{% endmacro %}

{# shared redirection success panel #}
{% macro renderRedirectSuccess(redirectUrl, spinnerMessage, continueText, redirectDelay='7000') %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <div class="hods-loading-spinner" role="status" data-redirect-url="{{ redirectUrl }}" data-redirect-delay="{{ redirectDelay }}">
        <div class="hods-loading-spinner__spinner"></div>
        <div class="hods-loading-spinner__content">
          <h1 class="govuk-heading-m">{{ spinnerMessage }}</h1>
        </div>
      </div>
      <p class="govuk-body">
        <a class="govuk-link govuk-link--no-visited-state" href="{{ redirectUrl }}">{{ continueText }}</a>
      </p>
    </div>
  </div>
{% endmacro %}

